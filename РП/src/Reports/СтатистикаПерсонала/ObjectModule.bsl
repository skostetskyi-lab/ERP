Функция ПреобразоватьМассивВТаблицу(Массив)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	Для Сч = 0 По Массив.Количество()-1 Цикл
		СтрокаТаблицы = Таблица.Добавить();  
		СтрокаТаблицы.Сотрудник = Массив[Сч].Сотрудник;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

