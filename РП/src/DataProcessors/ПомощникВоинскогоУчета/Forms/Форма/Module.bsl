КонецПроцедуры

&НаКлиенте
Процедура СоздатьЛистокСообщенияДляВоенкомата(Команда)
  
	Если Элементы.Сотрудники.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Если Элементы.КадровыеДокументыБезЛистков.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
  
	Ссылка = Элементы.КадровыеДокументыБезЛистков.ТекущиеДанные.Ссылка;
	
	Сотрудник = Элементы.Сотрудники.ТекущиеДанные.Ссылка; 
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриемНаРаботу") 
			ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.КадровыйПеревод") 
			ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.Увольнение")
			Тогда
		
		ПараметрыФормы = Новый Структура("Основание, Сотрудник", Ссылка,Сотрудник);
		ОткрытьФорму("Документ.ЛистокСообщенияДляВоенкомата.ФормаОбъекта", ПараметрыФормы);
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриемНаРаботуСписком") 
				ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.КадровыйПереводСписком") 
				ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.УвольнениеСписком")
				Тогда
				
		ПараметрыФормы = Новый Структура("ОснованиеСписком, Сотрудник", Ссылка, Сотрудник);
		ОткрытьФорму("Документ.ЛистокСообщенияДляВоенкомата.ФормаОбъекта", ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

