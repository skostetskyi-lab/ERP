&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (ИмяСобытия = "ИзмененыДанныеДополнительнойФормы" И Источник = ЭтаФорма) Тогда
		
		ПрочитатьДанныеИзХранилищаВФормуНаСервере(Параметр);
		СохранитьДанныеДополнительнойФормы(Параметр, Ложь);
		
		ОбновитьСписки(ЭтаФорма, Истина, Ложь);
		
	Конецесли;
	
	Если ИмяСобытия = "ИзменениеДанныхФизическогоЛица" 
		Тогда
		
		ОбновитьСписки(ЭтаФорма, Истина, Ложь);
		
	ИначеЕсли ИмяСобытия = "ИзменениеДанныхМестаРаботы" 
		Тогда
		
		ОбновитьСписки(ЭтаФорма, Истина, Истина);
		
	КонецЕсли; 
	
КонецПроцедуры
#КонецОбласти

&НаСервере
Процедура УстановитьОтборПоДате()
	
	ТекущаяРабочаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	
	ДатаОкончания = КонецДня(ТекущаяРабочаяДата);
	ДатаНачала = НачалоДня(ДатаОкончания);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "ДатаНачала", '00010101', Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "ДатаНачалаСведений", ДатаНачала, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "ДатаОкончания", ДатаОкончания, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Подразделения, "ДатаОкончания", ДатаОкончания, Истина);
		
	//слова виводу в таблиці співробітники
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "Забронирован", НСтр("ru='Забронировано в ';uk='Заброньовано в '"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "ОтменаБрони", НСтр("ru='Отмена брони в ';uk='Скасування броні в '"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "НетДанных", НСтр("ru='Нет данных';uk='Немає даних'"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "Нужнозаполнить", НСтр("ru='Нужно заполнить';uk='Потрібно заповнити'"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "НеУказанаОтстрочка", НСтр("ru='Не указана отстрочка';uk='Не вказана відстрочка'"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "НеПодлежитБронированию", НСтр("ru='Не подлежит бронированию';uk='Не підлягає бронюванню'"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "ЗабронированСторОрг", НСтр("ru='Бронь в стор. организации';uk='Бронь у стор. організації'"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Сотрудники, "Небронировался", НСтр("ru='Не бронировался';uk='Не бронювався'"), Истина);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНастройкиФормы()
	
	НастройкиСписка = СотрудникиФормыРасширенный.НастройкиСпискаФормы(ЭтаФорма, "Сотрудники");
	СотрудникиФормыРасширенный.ПрименитьНастройкиСписка(ЭтаФорма, НастройкиСписка, "Сотрудники", , Организация);
	УстановитьОтборПоДате();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СотрудникиКонтекстноеМенюУпорядочитьПоВажностиЗанимаемойДолжности",
		"Пометка",
		ПорядокПоВажностиУстановлен(ЭтаФорма));
	
	КонецПроцедуры
	
&НаСервере
Процедура УстановитьОтборВСписках(ОбновитьНастройки)
	
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Сотрудники, "Подразделение");
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Сотрудники, "Организация", Организация);
		УстановитьОтборПоФилиалу(ЭтаФорма, Организация);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(БронированиеГражданПребывающихВЗапасе, "Организация", Организация);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(КадровыеДокументыБезЛистков, "Организация", Организация);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Сотрудники, "Организация");
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Сотрудники, "ОтборПоФилиалуИЛИ");
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(БронированиеГражданПребывающихВЗапасе, "Организация");
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(КадровыеДокументыБезЛистков, "Организация");
		
	КонецЕсли;
	
	Если ОбновитьНастройки Тогда
		
		ОбновитьНастройкиФормы();
		
	КонецЕсли;
	
КонецПроцедуры

//++ ЕРП ЗИК
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКоманды(Источник)
	
	Если Источник.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник.ТекущаяСтрока) = Тип("ДокументСсылка.БронированиеГражданПребывающихВЗапасе") Тогда
		ДоступностьКомнады = Истина;
	Иначе
		ДоступностьКомнады = Ложь;
	Конецесли;
	
	Если Источник.КонтекстноеМеню.Имя = "БронированиеГражданПребывающихВЗапасеКонтекстноеМеню" Тогда
		Для Каждого ИмяКнопкиИлиПодменю Из Источник.КонтекстноеМеню.ПодчиненныеЭлементы Цикл
			Если СтрНайти(ИмяКнопкиИлиПодменю.Имя, "МенюКомандаПечати") > 0 Тогда
				ИмяКнопкиИлиПодменю.Доступность = ДоступностьКомнады;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
//-- ЕРП ЗИК

&НаСервере
Процедура УстановитьДанныеПоОрганизации(ОбновитьНастройки = Истина)
	
	УстановитьОтборВСписках(ОбновитьНастройки);
	
КонецПроцедуры

