    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	0 КАК ИндикаторПроблем,
	СправочникСотрудники.Ссылка КАК Ссылка,
	СправочникСотрудники.Код КАК Код,
	ДанныеДляПодбора.Наименование КАК НаименованиеСотрудника,
	ВЫБОР
		КОГДА ДанныеДляПодбора.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			ТОГДА СправочникСотрудники.ГоловнаяОрганизация
		ИНАЧЕ ДанныеДляПодбора.Организация
	КОНЕЦ КАК ГоловнаяОрганизация,
	ВЫБОР
		КОГДА ДанныеДляПодбора.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			ТОГДА СправочникСотрудники.ГоловнаяОрганизация
		ИНАЧЕ ДанныеДляПодбора.Организация
	КОНЕЦ КАК Организация,
	СправочникСотрудники.ВАрхиве КАК ВАрхиве,
	ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения КАК ДатаУвольнения,
	ТекущиеКадровыеДанныеСотрудников.ТекущийВидЗанятости КАК ВидЗанятости,
	ТекущиеКадровыеДанныеСотрудников.ТекущийВидДоговора КАК ВидДоговора,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.Пол КАК Пол,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.КодПоДРФО КАК КодПоДРФО,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.ДатаРождения КАК ДатаРождения,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.МестоРождения КАК МестоРождения,
	ВЫБОР
		КОГДА ДанныеДляПодбора.Филиал = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			ТОГДА СправочникСотрудники.ГоловнаяОрганизация
		ИНАЧЕ ДанныеДляПодбора.Филиал
	КОНЕЦ КАК Филиал,
	ДанныеДляПодбора.Подразделение КАК Подразделение,
	ДанныеДляПодбора.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписанию,
	ДанныеДляПодбора.Должность КАК Должность,
	ВЫБОР
		КОГДА ДанныеДляПодбора.Филиал = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			ТОГДА &quot;99999&quot;
		КОГДА ДанныеДляПодбора.Подразделение = ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)
			ТОГДА &quot;99998&quot;
		ИНАЧЕ ДанныеДляПодбора.Подразделение.РеквизитДопУпорядочиванияИерархического
	КОНЕЦ КАК ПорядокПодразделения,
	ВЫБОР
		КОГДА ДанныеДляПодбора.Начало = ДАТАВРЕМЯ(1, 1, 1)
				И ДанныеДляПодбора.Окончание &lt;> ДАТАВРЕМЯ(1, 1, 1)
				И ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность &lt;> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
			ТОГДА ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность.РеквизитДопУпорядочивания
		КОГДА ДанныеДляПодбора.Должность = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
			ТОГДА 0
		ИНАЧЕ ДанныеДляПодбора.Должность.РеквизитДопУпорядочивания
	КОНЕЦ КАК ПорядокДолжности,
	ДанныеДляПодбора.ЭтоГоловнойСотрудник КАК ЭтоГоловнойСотрудник,
	ДанныеДляПодбора.Начало КАК Начало,
	ДанныеДляПодбора.Окончание КАК Окончание,
	ВЫБОР
		КОГДА ДанныеДляПодбора.Филиал = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			ТОГДА ДанныеДляПодбора.Филиал
		ИНАЧЕ ДанныеДляПодбора.Организация
	КОНЕЦ КАК ОрганизацияСотрудника,
	// дані війскового обліку
	ВЫБОР
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ NULL
			ТОГДА ПРЕДСТАВЛЕНИЕ(&amp;НетДанных)
		ИНАЧЕ ВоинскийУчетСрезПоследних.ОтношениеКВоинскойОбязанности
	КОНЕЦ КАК ДанныеВУ,
	ВЫБОР
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL
			ТОГДА ВоинскийУчетСрезПоследних.НомерЗаписиВРеестреВоеннообязанных
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК НомерЗаписиВРеестреВоеннообязанных,
	ВЫБОР
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL
			ТОГДА ВоинскийУчетСрезПоследних.ОтношениеКВоинскомуУчету
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК ОтношениеКВоинскомуУчету,
	ВЫБОР
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL
			ТОГДА ВоинскийУчетСрезПоследних.ГруппаУчетаКарточкиВоинскогоУчета
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК ГруппаУчетаКарточкиВоинскогоУчета,
	ВЫБОР
		КОГДА (ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL) И (БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ NULL)
			ТОГДА
			ВЫБОР
			 	КОГДА ВоинскийУчетСрезПоследних.СпецУчет &lt;> &quot;&quot; 
			 		ТОГДА ВоинскийУчетСрезПоследних.СпецУчет
				КОГДА ВоинскийУчетСрезПоследних.СпецУчет = &quot;&quot; 
			  		  И ВоинскийУчетСрезПоследних.ОснованиеОтсрочки=&quot;&quot;
			          И Не ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизацией
					ТОГДА &quot;&quot;
			КОНЕЦ
		КОГДА (ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL) И (БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ НЕ NULL)
			ТОГДА
			ВЫБОР
			 	КОГДА ВоинскийУчетСрезПоследних.СпецУчет &lt;> &quot;&quot;
			 		ТОГДА ВоинскийУчетСрезПоследних.СпецУчет
				КОГДА ВоинскийУчетСрезПоследних.СпецУчет = &quot;&quot; 
			  		  И ВоинскийУчетСрезПоследних.ОснованиеОтсрочки=&quot;&quot;
			          И Не ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизацией
			          И ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.БронированиеГражданПребывающихВЗапасе)
					ТОГДА &amp;Нужнозаполнить
			КОНЕЦ
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК СпецУчет,
	ВЫБОР
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL
			ТОГДА
			ВЫБОР
				КОГДА ВоинскийУчетСрезПоследних.ОснованиеОтсрочки &lt;> &quot;&quot;
					ТОГДА ВоинскийУчетСрезПоследних.ОснованиеОтсрочки
			    КОГДА (ВоинскийУчетСрезПоследних.ОснованиеОтсрочки = &quot;&quot;) И (ВоинскийУчетСрезПоследних.СрокОтсрочки&lt;> ДАТАВРЕМЯ(1,1,1))
					ТОГДА &amp;НеУказанаОтстрочка
				ИНАЧЕ &quot;&quot;
			КОНЕЦ
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК Отстрочка,
	//бронювання
	ВЫБОР
		КОГДА (ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL) И (БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ NULL)
			ТОГДА
			ВЫБОР
				КОГДА ВоинскийУчетСрезПоследних.ОснованиеОтсрочки &lt;> &quot;&quot;
					ТОГДА &amp;НеПодлежитБронированию
				КОГДА (ВоинскийУчетСрезПоследних.ОснованиеОтсрочки = &quot;&quot;) И (ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизацией)
					ТОГДА &amp;ЗабронированСторОрг
			ИНАЧЕ &amp;Небронировался
			КОНЕЦ
		КОГДА (ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL) И (БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ НЕ NULL)
			ТОГДА
			ВЫБОР
				КОГДА ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.БронированиеГражданПребывающихВЗапасе)
					ТОГДА &amp;Забронирован + БронированиеСотрудниковСрезПоследних.Организация.Наименование
				КОГДА ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.ОтменаБронированияГражданПребывающихВЗапасе) И (ВоинскийУчетСрезПоследних.ОснованиеОтсрочки = &quot;&quot;)
					ТОГДА &amp;ОтменаБрони + БронированиеСотрудниковСрезПоследних.Регистратор.Организация.Наименование
				КОГДА ВоинскийУчетСрезПоследних.ОснованиеОтсрочки &lt;> &quot;&quot;
					ТОГДА &amp;НеПодлежитБронированию
				КОГДА (ВоинскийУчетСрезПоследних.ОснованиеОтсрочки = &quot;&quot;) И (ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизацией)
					ТОГДА &amp;ЗабронированСторОрг
			КОНЕЦ
		КОГДА (ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ NULL) И (БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ НЕ NULL)
			ТОГДА
			ВЫБОР
				КОГДА ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.БронированиеГражданПребывающихВЗапасе)
					ТОГДА &amp;Забронирован + БронированиеСотрудниковСрезПоследних.Организация.Наименование
				КОГДА ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.ОтменаБронированияГражданПребывающихВЗапасе)
					ТОГДА &amp;ОтменаБрони + БронированиеСотрудниковСрезПоследних.Регистратор.Организация.Наименование
			КОНЕЦ
		ИНАЧЕ &amp;Небронировался
	КОНЕЦ КАК Бронирование,
	// дата відстрочки або бронювання/відміни бронюання
	ВЫБОР
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL И БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ NULL
			ТОГДА
			ВЫБОР
				КОГДА ВоинскийУчетСрезПоследних.СрокОтсрочки &lt;> ДАТАВРЕМЯ(1,1,1)
					ТОГДА ВоинскийУчетСрезПоследних.СрокОтсрочки
				КОГДА (ВоинскийУчетСрезПоследних.ОснованиеОтсрочки = &quot;&quot;) 
					  И (ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизацией) 
					  И (ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизациейСрок&lt;> ДАТАВРЕМЯ(1,1,1))
				    ТОГДА ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизациейСрок
				КОНЕЦ
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ НЕ NULL И БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ НЕ NULL
			ТОГДА 
			ВЫБОР
				КОГДА ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.БронированиеГражданПребывающихВЗапасе)
					ТОГДА БронированиеСотрудниковСрезПоследних.СрокБронирования
				КОГДА (ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.ОтменаБронированияГражданПребывающихВЗапасе)) И (ВоинскийУчетСрезПоследних.ОснованиеОтсрочки = &quot;&quot;)
					ТОГДА БронированиеСотрудниковСрезПоследних.Регистратор.Дата
				КОГДА ВоинскийУчетСрезПоследних.СрокОтсрочки &lt;> ДАТАВРЕМЯ(1,1,1)
					ТОГДА ВоинскийУчетСрезПоследних.СрокОтсрочки
				КОГДА (ВоинскийУчетСрезПоследних.ОснованиеОтсрочки = &quot;&quot;) 
					  И (ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизацией) 
					  И (ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизациейСрок&lt;> ДАТАВРЕМЯ(1,1,1))
					ТОГДА ВоинскийУчетСрезПоследних.ЗабронированСтороннейОрганизациейСрок
			КОНЕЦ
		КОГДА ВоинскийУчетСрезПоследних.ФизическоеЛицо ЕСТЬ NULL И БронированиеСотрудниковСрезПоследних.Регистратор ЕСТЬ НЕ NULL
			ТОГДА 
			ВЫБОР
				КОГДА ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.БронированиеГражданПребывающихВЗапасе)
					ТОГДА БронированиеСотрудниковСрезПоследних.СрокБронирования
				КОГДА ТИПЗНАЧЕНИЯ(БронированиеСотрудниковСрезПоследних.Регистратор) = ТИП(Документ.ОтменаБронированияГражданПребывающихВЗапасе)
					ТОГДА БронированиеСотрудниковСрезПоследних.Регистратор.Дата

			КОНЕЦ
	КОНЕЦ КАК ДатаОтстрочка
ИЗ
	РегистрСведений.ДанныеДляПодбораСотрудников КАК ДанныеДляПодбора
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК СправочникСотрудники
		ПО ДанныеДляПодбора.Сотрудник = СправочникСотрудники.Ссылка
			И ДанныеДляПодбора.Наименование = СправочникСотрудники.Наименование
			И (ДанныеДляПодбора.ИдентификаторЗаписи В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					ДанныеДляПодбораСотрудниковОтбор.ИдентификаторЗаписи
				ИЗ
					РегистрСведений.ДанныеДляПодбораСотрудников КАК ДанныеДляПодбораСотрудниковОтбор
				ГДЕ
					ДанныеДляПодбораСотрудниковОтбор.Сотрудник = ДанныеДляПодбора.Сотрудник
					И ДанныеДляПодбораСотрудниковОтбор.Наименование = ДанныеДляПодбора.Наименование
					И ДанныеДляПодбораСотрудниковОтбор.Начало &lt;= КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
					И ДанныеДляПодбораСотрудниковОтбор.ПоДоговоруГПХ = ЛОЖЬ
					И (ДанныеДляПодбораСотрудниковОтбор.ВидЗанятости = ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ОсновноеМестоРаботы)
							И ДанныеДляПодбораСотрудниковОтбор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровССотрудниками.ТрудовойДоговор)
						ИЛИ ДанныеДляПодбораСотрудниковОтбор.ВидЗанятости = ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.Совместительство)
							И ДанныеДляПодбораСотрудниковОтбор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровССотрудниками.ГигКонтракт)
						ИЛИ ДанныеДляПодбораСотрудниковОтбор.ВидЗанятости = ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.Совместительство)
							И ДанныеДляПодбораСотрудниковОтбор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровССотрудниками.ТрудовойДоговор))
					//И (ДанныеДляПодбораСотрудниковОтбор.Окончание = ДАТАВРЕМЯ(1, 1, 1)
					//	ИЛИ ДанныеДляПодбораСотрудниковОтбор.Окончание >= НАЧАЛОПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ))
				УПОРЯДОЧИТЬ ПО
					ДанныеДляПодбораСотрудниковОтбор.Начало УБЫВ,
					ДанныеДляПодбораСотрудниковОтбор.Организация,
					ДанныеДляПодбораСотрудниковОтбор.Филиал,
					ДанныеДляПодбораСотрудниковОтбор.Подразделение,
					ДанныеДляПодбораСотрудниковОтбор.ПоДоговоруГПХ))
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВоинскийУчет.СрезПоследних КАК ВоинскийУчетСрезПоследних
			ПО ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = ВоинскийУчетСрезПоследних.ФизическоеЛицо
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БронированиеСотрудников.СрезПоследних КАК БронированиеСотрудниковСрезПоследних
			ПО ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = БронированиеСотрудниковСрезПоследних.ФизическоеЛицо
		ПО ДанныеДляПодбора.Сотрудник = ТекущиеКадровыеДанныеСотрудников.Сотрудник
			И ДанныеДляПодбора.ФизическоеЛицо = ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо
			И ДанныеДляПодбора.ВидЗанятости = ТекущиеКадровыеДанныеСотрудников.ТекущийВидЗанятости
			И ДанныеДляПодбора.ВидДоговора = ТекущиеКадровыеДанныеСотрудников.ТекущийВидДоговора}</queryText>
      <mainTable>Catalog.Сотрудники</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
