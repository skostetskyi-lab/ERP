	Если ПараметрПериод = Неопределено Тогда
		ПараметрПериод = ОтчетыКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПериодОтчета");
	КонецЕсли;
	ПараметрПериод.Значение.ДатаНачала = ДатаНачалаПериодаОтчета;
	ПараметрПериод.Значение.ДатаОкончания = ДатаКонцаПериодаОтчета;
	
	Если ПараметрыОтчета.Свойство("СНачалаГода") Тогда
		ПараметрСНачалаГода = ОтчетыКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "СНачалаГода");
		Если ПараметрСНачалаГода <> Неопределено Тогда
			ПараметрСНачалаГода.Значение = ПараметрыОтчета.СНачалаГода;
		КонецЕсли;
	КонецЕсли;
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	Отбор = Настройки.Отбор;
	Отбор.Элементы.Очистить();
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Организация", ВидСравненияКомпоновкиДанных.Равно, Организация);
	
	Если ПараметрыОтчета.Свойство("Пол") Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник.ФизическоеЛицо.Пол", ВидСравненияКомпоновкиДанных.Равно, Перечисления.ПолФизическогоЛица.Женский);
	КонецЕсли;
	Если ПараметрыОтчета.Свойство("мСельскиеЖители") Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник", ВидСравненияКомпоновкиДанных.ВСписке, ПараметрыОтчета.мСельскиеЖители);
	КонецЕсли;
	
	Если ПараметрыОтчета.Свойство("НачалоИнтервала") И ПараметрыОтчета.Свойство("ОкончаниеИнтервала") Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник.ФизическоеЛицо.ДатаРождения", ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, ПараметрыОтчета.НачалоИнтервала);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник.ФизическоеЛицо.ДатаРождения", ВидСравненияКомпоновкиДанных.БольшеИлиРавно, ПараметрыОтчета.ОкончаниеИнтервала);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник.ФизическоеЛицо.ДатаРождения", ВидСравненияКомпоновкиДанных.НеРавно, Дата(1,1,1,0,0,0));
	КонецЕсли;
	Если ПараметрыОтчета.Свойство("НачалоИнтервала") И НЕ ПараметрыОтчета.Свойство("ОкончаниеИнтервала") Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник.ФизическоеЛицо.ДатаРождения", ВидСравненияКомпоновкиДанных.Меньше, ПараметрыОтчета.НачалоИнтервала);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник.ФизическоеЛицо.ДатаРождения", ВидСравненияКомпоновкиДанных.НеРавно, Дата(1,1,1,0,0,0));
	КонецЕсли;
	// Далее следует настройка варианта расшифровки.
	Если Вариант <> "Расшифровка" Тогда
		Возврат КомпоновщикНастроек.ПолучитьНастройки();
	КонецЕсли;
	
	НомерСтроки = ПараметрыОтчета.НомерСтроки;
	НомерКолонки = ПараметрыОтчета.НомерКолонки;
	
	ВидОтчета = ПараметрыОтчета.ВидОтчета;
	
	// Включение полей отчета, по которым выводится расшифровка.
	ВключитьВычисляемоеПоле(Настройки.Выбор, "Сотрудник");
	
	
	Возврат КомпоновщикНастроек.ПолучитьНастройки();
	
КонецФункции
Процедура ВключитьВычисляемоеПоле(ВыбранныеПоля, ИмяПоля)
	
	Если Лев(ИмяПоля, 20) = "ПользовательскиеПоля" Тогда
		ИмяПоля = СтрЗаменить(ИмяПоля, "ПользовательскиеПоля", "ПользовательскиеПоля.");
	КонецЕсли;
	
	ИскомоеПоле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	Для Каждого НастройкаПоля Из ВыбранныеПоля.Элементы Цикл
		Если НастройкаПоля.Поле = ИскомоеПоле Тогда
			НастройкаПоля.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПодразделенияИсключения(Организация, Подразделение, ИсключитьДанныеОбособленныхПодразделений)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Если ИсключитьДанныеОбособленныхПодразделений  Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияОрганизаций.Ссылка
		|ПОМЕСТИТЬ ВТПодразделенияВерхнегоУровня
		|ИЗ
		|	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
		|ГДЕ
		|	ПодразделенияОрганизаций.Владелец = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодразделенияОрганизаций.Ссылка
		|ИЗ
		|	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
		|ГДЕ
		|	ПодразделенияОрганизаций.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				ПодразделенияВерхнегоУровня.Ссылка
		|			ИЗ
		|				ВТПодразделенияВерхнегоУровня КАК ПодразделенияВерхнегоУровня)
		|	И ПодразделенияОрганизаций.Владелец = &Организация";
		ПустыеКоды = Новый Массив;
		ПустыеКоды.Добавить("");
		ПустыеКоды.Добавить("              ");
		Запрос.УстановитьПараметр("ПустыеКоды", ПустыеКоды);
		
	ИначеЕсли ЗначениеЗаполнено(Подразделение) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияОрганизаций.Ссылка
		|ИЗ
		|	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
		|ГДЕ
		|	ПодразделенияОрганизаций.Ссылка В ИЕРАРХИИ(&Подразделение)
		|	И ПодразделенияОрганизаций.Владелец = &Организация";
		Запрос.УстановитьПараметр("Подразделение", Подразделение);
		
	Иначе
		
		Возврат Новый Массив
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции 

//Повертає дані часу для розрахунку еквівалента повної зайнятості
//
Функция ДанныеВремениДляРасчетаЭПЗ(ТаблицаСотрудников, Организация, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Сотрудники", ТаблицаСотрудников);
	Запрос.УстановитьПараметр("Период", НачалоМесяца(Период));
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сотрудники.Сотрудник,
	|	&Период КАК ДатаНачала,
	|	КОНЕЦПЕРИОДА(&Период, МЕСЯЦ) КАК ДатаОкончания
	|ПОМЕСТИТЬ ВТСотрудники
	|ИЗ
	|  	&Сотрудники КАК Сотрудники";
	
	Запрос.Выполнить();
	
	ПараметрыЗаполнения = УчетРабочегоВремени.ПараметрыДляЗапросВТДанныеУчетаВремениИСостоянийСотрудников();
		
	ПараметрыЗаполнения.ИмяВТСотрудники = "ВТСотрудники";
	ПараметрыЗаполнения.ИмяВТРезультат = "ВТДанныеУчетаВремениИСостоянийСотрудников";
	ПараметрыЗаполнения.РассчитыватьПлановоеВремя = Истина;
	ПараметрыЗаполнения.Организация  = Организация;
	ПараметрыЗаполнения.ДатаАктуальности  = КонецМесяца(Период);
	ПараметрыЗаполнения.ДатаНачала = НачалоМесяца(Период);
	ПараметрыЗаполнения.ДатаОкончания = КонецМесяца(Период);
			
	ПараметрыЗаполнения.МесяцДатаНачала = НачалоМесяца(Период);
	ПараметрыЗаполнения.МесяцДатаОкончания = КонецМесяца(Период);
			
	ПараметрыЗаполнения.ПолучатьУжеРассчитанныеДанные = Ложь;
	ПараметрыЗаполнения.ПолучатьУсловияТрудаИТерритории = Ложь;
			
	УчетРабочегоВремени.СоздатьВТДанныеУчетаВремениИСостоянийСотрудников(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыЗаполнения);	
	
	МассивВидыВремениЧасы = Новый Массив();
	//Види відпрацьованого часу, окрім понаднормових
	МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.Явка);
	МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.РаботаВРежимеНеполногоВремени);
	МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.РаботаВечерниеЧасы);
	МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.РаботаНочныеЧасы);
	МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.Праздники);
	Попытка
		МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ПраздникиБезПовышеннойОплаты);
	Исключение
	КонецПопытки;	
	МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.Командировка);
	МассивВидыВремениЧасы.Добавить(Справочники.ВидыИспользованияРабочегоВремени.СокращенноеРабочееВремя);
	
	МассивВидыВремениНорма = Новый Массив();
	//Невідпрацьований час з оплатою, беруться години за нормою графіку
	МассивВидыВремениНорма.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ДополнительныйОтпуск);
	МассивВидыВремениНорма.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ОсновнойОтпуск);
	МассивВидыВремениНорма.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ОтпускНаДетей);
	МассивВидыВремениНорма.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ОтпускНаОбучение);
	МассивВидыВремениНорма.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ЧернобыльскийОтпуск);
	МассивВидыВремениНорма.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ТворческийОтпуск);
	МассивВидыВремениНорма.Добавить(Справочники.ВидыИспользованияРабочегоВремени.ГосударственныеОбязанности);
	
	МассивИсключаемыеСостояния = Новый Массив();
	//Стани, без оплати але з потрібним видом часу, треба виключити додатково
	МассивИсключаемыеСостояния.Добавить(Перечисления.СостоянияСотрудника.МобилизацияБезОплаты);
	
	Запрос.УстановитьПараметр("МассивВидыВремениЧасы", МассивВидыВремениЧасы);
	Запрос.УстановитьПараметр("МассивВидыВремениНорма", МассивВидыВремениНорма);
	Запрос.УстановитьПараметр("МассивИсключаемыеСостояния", МассивИсключаемыеСостояния);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияСотрудников.Сотрудник,
	|	СостоянияСотрудников.НачалоПериода,
	|	СостоянияСотрудников.ОкончаниеПериода
	|ПОМЕСТИТЬ ВТИсключаемыеСостояния
	|ИЗ
	|  	ВТСостоянияСотрудников КАК СостоянияСотрудников
	|ГДЕ
	|	СостоянияСотрудников.Состояние В (&МассивИсключаемыеСостояния)
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник,
	|	ДанныеУчетаВремениИСостоянийСотрудников.ВидУчетаВремени,
	|	ДанныеУчетаВремениИСостоянийСотрудников.Дата,
	|	ВЫБОР
	|   	КОГДА ИсключаемыеСостояния.Сотрудник ЕСТЬ NULL
	|			ТОГДА ДанныеУчетаВремениИСостоянийСотрудников.Часы
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Часы,
	|	ВЫБОР
	|   	КОГДА ИсключаемыеСостояния.Сотрудник ЕСТЬ NULL
	|			ТОГДА ДанныеУчетаВремениИСостоянийСотрудников.НормаЧасов
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НормаЧасов
	|ПОМЕСТИТЬ ВТДанныеУчетаВремениИСостоянийСотрудниковСФильтром
	|ИЗ
	|  	ВТДанныеУчетаВремениИСостоянийСотрудников КАК ДанныеУчетаВремениИСостоянийСотрудников
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|	ВТИсключаемыеСостояния КАК ИсключаемыеСостояния
	|	ПО ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник =  ИсключаемыеСостояния.Сотрудник
	|	И ДанныеУчетаВремениИСостоянийСотрудников.Дата >= ИсключаемыеСостояния.НачалоПериода
	|	И ДанныеУчетаВремениИСостоянийСотрудников.Дата <= ИсключаемыеСостояния.ОкончаниеПериода
	|;
	|
	|ВЫБРАТЬ
	|	ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник,
	|	СУММА(ВЫБОР
	|   	КОГДА ДанныеУчетаВремениИСостоянийСотрудников.ВидУчетаВремени В (&МассивВидыВремениЧасы)
	|			ТОГДА ДанныеУчетаВремениИСостоянийСотрудников.Часы
	|       КОГДА ДанныеУчетаВремениИСостоянийСотрудников.ВидУчетаВремени В (&МассивВидыВремениНорма)
	|			ТОГДА ДанныеУчетаВремениИСостоянийСотрудников.НормаЧасов
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Работа
	|ПОМЕСТИТЬ ВТЭПЗ_Работа
	|ИЗ
	|  	ВТДанныеУчетаВремениИСостоянийСотрудниковСФильтром КАК ДанныеУчетаВремениИСостоянийСотрудников
	|СГРУППИРОВАТЬ ПО
	|	ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник
	|;
	|
	|ВЫБРАТЬ
	|	ПериодыДейсвияОбщихГрафиковСотрудников.Сотрудник,
	|   МИНИМУМ(ПериодыДейсвияОбщихГрафиковСотрудников.ДатаНачала) КАК ДатаМинимум,
	|	МАКСИМУМ(ПериодыДейсвияОбщихГрафиковСотрудников.ДатаОкончания) КАК ДатаМаксимум
	|ПОМЕСТИТЬ ВТЭПЗ_ПериодыГрафиковМинМакс
	|ИЗ
	|  	ВТПериодыДейсвияОбщихГрафиковСотрудников КАК ПериодыДейсвияОбщихГрафиковСотрудников
	|СГРУППИРОВАТЬ ПО
	|	ПериодыДейсвияОбщихГрафиковСотрудников.Сотрудник
	|;
	|
	|ВЫБРАТЬ
	|	ПериодыДейсвияОбщихГрафиковСотрудников.Сотрудник,
	|	ПериодыДейсвияОбщихГрафиковСотрудников.ГрафикРаботыНорма,
	|   ВЫБОР 
	|		КОГДА ПериодыДейсвияОбщихГрафиковСотрудников.ДатаНачала = ПериодыГрафиковМинМакс.ДатаМинимум
	|			ТОГДА НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)
	|       	ИНАЧЕ ПериодыДейсвияОбщихГрафиковСотрудников.ДатаНачала 
	|   КОНЕЦ КАК ДатаНачала, 
	|   ВЫБОР 
	|		КОГДА ПериодыДейсвияОбщихГрафиковСотрудников.ДатаОкончания = ПериодыГрафиковМинМакс.ДатаМаксимум
	|			ТОГДА КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
	|       	ИНАЧЕ ПериодыДейсвияОбщихГрафиковСотрудников.ДатаОкончания 
	|   КОНЕЦ КАК ДатаОкончания
	|ПОМЕСТИТЬ ВТЭПЗ_ПериодыГрафиков
	|ИЗ
	|  	ВТПериодыДейсвияОбщихГрафиковСотрудников КАК ПериодыДейсвияОбщихГрафиковСотрудников
	|   ЛЕВОЕ СОЕДИНЕНИЕ
	|   ВТЭПЗ_ПериодыГрафиковМинМакс КАК ПериодыГрафиковМинМакс 
	|   ПО ПериодыДейсвияОбщихГрафиковСотрудников.Сотрудник = ПериодыГрафиковМинМакс.Сотрудник
	|;
	|
	|ВЫБРАТЬ
	|	ПериодыГрафиков.Сотрудник,
	|   СУММА(ДанныеОбщихГрафиков.Часов) КАК Норма
	|ПОМЕСТИТЬ ВТЭПЗ_Норма
	|ИЗ
	|  	ВТЭПЗ_ПериодыГрафиков КАК ПериодыГрафиков
	|   ЛЕВОЕ СОЕДИНЕНИЕ
	|   ВТДанныеОбщихГрафиков КАК ДанныеОбщихГрафиков 
	|   ПО ПериодыГрафиков.ГрафикРаботыНорма = ДанныеОбщихГрафиков.ГрафикРаботы
	|    И ПериодыГрафиков.ДатаНачала <= ДанныеОбщихГрафиков.Дата
	|    И ПериодыГрафиков.ДатаОкончания >= ДанныеОбщихГрафиков.Дата
	|СГРУППИРОВАТЬ ПО
	|	ПериодыГрафиков.Сотрудник
	|;
	|
	|ВЫБРАТЬ
	|	НормаВремени.Сотрудник,
	|   СУММА(НормаВремени.ЧасыПлан) КАК Норма
	|ПОМЕСТИТЬ ВТЭПЗ_Норма2
	|ИЗ
	|  	ВТНормаВремени КАК НормаВремени
	|СГРУППИРОВАТЬ ПО
	|	НормаВремени.Сотрудник
	|;
	|
	|ВЫБРАТЬ
	|	Сотрудники.Сотрудник,
	|   ДанныеРабота.Работа КАК Работа,
	|   ЕСТЬNULL(ДанныеНорма.Норма, ЕСТЬNULL(ДанныеНорма2.Норма,0))	КАК Норма
	|ИЗ
	|  	ВТСотрудники КАК Сотрудники
	|   ЛЕВОЕ СОЕДИНЕНИЕ
	|   ВТЭПЗ_Работа КАК ДанныеРабота 
	|   ПО Сотрудники.Сотрудник = ДанныеРабота.Сотрудник
	|   ЛЕВОЕ СОЕДИНЕНИЕ
	|   ВТЭПЗ_Норма КАК ДанныеНорма 
	|   ПО Сотрудники.Сотрудник = ДанныеНорма.Сотрудник
	|   ЛЕВОЕ СОЕДИНЕНИЕ
	|   ВТЭПЗ_Норма2 КАК ДанныеНорма2 
	|   ПО Сотрудники.Сотрудник = ДанныеНорма2.Сотрудник";

	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Чтение настроек подсистемы статистики персонала.
// Если формирование отчетных форм статистики отключено, функция возвращает
// структуру с единственным реквизитом ИспользоватьОтчетностьМониторингаРаботниковСоциальнойСферы,
// установленным в значение ЛОЖЬ.
//
// ВозвращаемоеЗначение:
//  Структура настроек
//
Функция НастройкиСтатистикиПерсонала() Экспорт

	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ИспользоватьОтчетностьМониторингаРаботниковСоциальнойСферы", Ложь);
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОтчетностьМониторингаРаботниковСоциальнойСферы") Тогда
		Возврат СтруктураНастроек;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиСтатистикиПерсонала.ИспользоватьОтчетностьМониторингаРаботниковСоциальнойСферы,
		|	НастройкиСтатистикиПерсонала.ФормаОтчетностиМониторингаРаботниковСоциальнойСферы
		|ИЗ
		|	РегистрСведений.НастройкиСтатистикиПерсонала КАК НастройкиСтатистикиПерсонала";

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Если РезультатЗапроса.Количество() > 0 Тогда
		СтруктураНастроек = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатЗапроса[0]);
	КонецЕсли;
	
	Возврат СтруктураНастроек;

КонецФункции

Процедура УстановитьПустоеЗначение(Значение, ИмяЯчейки, Контейнер) Экспорт
	Если Контейнер.ПолеТабличногоДокументаФормаОтчета.Свойство(ИмяЯчейки) И (Значение = 0 Или Значение = Null) Тогда
		Контейнер.ПолеТабличногоДокументаФормаОтчета[ИмяЯчейки] = "ЧН=-";
	КонецЕсли;		
КонецПроцедуры

Процедура УстановитьПустоеЗначениеЧисленности(Значение, ИмяЯчейки, Контейнер) Экспорт
	Если Контейнер.ПолеТабличногоДокументаФормаОтчета.Свойство(ИмяЯчейки) И (Значение = Null Или Значение < 0.1) Тогда
		Контейнер.ПолеТабличногоДокументаФормаОтчета[ИмяЯчейки] = "ЧН=-";
	КонецЕсли;
КонецПроцедуры


