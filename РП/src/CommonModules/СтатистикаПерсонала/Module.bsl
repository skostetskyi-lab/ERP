	ПараметрыОтчета.Удалить("ОкончаниеИнтервала");
	ПараметрыОтчета.Удалить("Пол");
	
	ДанныеОтчета = Новый ДеревоЗначений;
	ДанныеДляЗаполненияРегламентированнойОтчетностиКадры10ПИ("СреднесписочнаяЧисленность", СхемаКомпоновки,
		ПараметрыОтчета, ДанныеОтчета);
		
	СтрокаОрганизации = ДанныеОтчета.Строки.Найти(Организация, "Организация");
	
	ЧисленностьИнвалидовОт60 = 0;
	
	Если НЕ СтрокаОрганизации = Неопределено Тогда
		ЧисленностьИнвалидовОт60 = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов/ЧислоМесяцев, 5)));
	КонецЕсли;	

	ПараметрыОтчета.Вставить("Пол", Перечисления.ПолФизическогоЛица.Женский);

	ДанныеОтчета = Новый ДеревоЗначений;
	ДанныеДляЗаполненияРегламентированнойОтчетностиКадры10ПИ("СреднесписочнаяЧисленность", СхемаКомпоновки,
		ПараметрыОтчета, ДанныеОтчета);
		
	СтрокаОрганизации = ДанныеОтчета.Строки.Найти(Организация, "Организация");
	Если НЕ СтрокаОрганизации = Неопределено Тогда
		ДанныеЧисленности.ЧисленностьЖенщинИнвалидовОт60 = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов/ЧислоМесяцев, 5)));
	КонецЕсли;	
	ДанныеЧисленности.ЧисленностьМужчинИнвалидовОт60 = ЧисленностьИнвалидовОт60 - ДанныеЧисленности.ЧисленностьЖенщинИнвалидовОт60;

