////////////////////////////////////////////////////////////////////////////////
// Функции для регламентированной отчетности.

// Возвращает среднесписочную численность, в т.ч. женщин и инвалидов
// 
// Параметры:
//		Организация
//		НачалоПериода
//		КонецПериода
//		ДанныеЧисленности - Структура - с полями ЧисленностьРаботников, ЧисленностьЖенщин, ЧисленностьИнвалидов.
//
Процедура СреднесписочнаяЧисленностьРаботающих(Организация, НачалоПериода, КонецПериода, ДанныеЧисленности, ИсключатьПериодыПоПравилам1ПВ = Истина,  ИсключатьТяжелыеУсловияТруда = Ложь) Экспорт

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация", Организация);
	ПараметрыОтчета.Вставить("ДатаНачалаПериодаОтчета", НачалоПериода);
	ПараметрыОтчета.Вставить("ДатаКонцаПериодаОтчета", КонецПериода);
	ПараметрыОтчета.Вставить("ДатаНачалаПериодаВыборки", НачалоПериода);
	ПараметрыОтчета.Вставить("ИсключатьПериодыПоПравилам1ПВ", ИсключатьПериодыПоПравилам1ПВ); 
	ПараметрыОтчета.Вставить("ИсключатьТяжелыеУсловияТруда", ИсключатьТяжелыеУсловияТруда);

	// Получение данных отчета
	ДанныеОтчета = Новый ДеревоЗначений;
	ДанныеДляЗаполненияРегламентированнойОтчетностиКадры("СреднесписочнаяЧисленность",
		ПараметрыОтчета, ДанныеОтчета);
	
	СтрокаОрганизации = ДанныеОтчета.Строки.Найти(Организация, "Организация");
	
	Если СтрокаОрганизации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧислоМесяцев = 12*(Год(НачалоПериода) - Год(КонецПериода)) + Месяц(КонецПериода) - Месяц(НачалоПериода) + 1;
	
	Если ЧислоМесяцев = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ДанныеЧисленности.ЧисленностьЖенщин = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьЖенщин), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьЖенщин/ЧислоМесяцев, 5)));
	ДанныеЧисленности.ЧисленностьИнвалидов = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов), 0,Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов/ЧислоМесяцев, 5)));
	ДанныеЧисленности.ЧисленностьРаботников = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленность), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленность/ЧислоМесяцев, 5)));	
	ДанныеЧисленности.ЧисленностьВнешнихСовместителей = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьВнешнихСовместителей), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьВнешнихСовместителей/ЧислоМесяцев, 5)));	
	ДанныеЧисленности.ЧисленностьЧисленностьРаботниковГПХ = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьРаботниковГПХ), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьРаботниковГПХ/ЧислоМесяцев, 5)));
	ДанныеЧисленности.ЧисленностьЛицСГарантиями = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьЛицСГарантиями), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьЛицСГарантиями/ЧислоМесяцев, 5)));	
	ДанныеЧисленности.ЧисленностьЛицСГарантиямиМеньше10ЛетДоПенсии = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьЛицСГарантиямиМеньше10ЛетДоПенсии), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьЛицСГарантиямиМеньше10ЛетДоПенсии/ЧислоМесяцев, 5)));	
	ДанныеЧисленности.ЧисленностьЛицСГарантиямиНеИнвалиды = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьЛицСГарантиямиНеИнвалиды), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьЛицСГарантиямиНеИнвалиды/ЧислоМесяцев, 5)));	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьГигКонтракты") Тогда
		ДанныеЧисленности.ЧисленностьРаботниковПоГигКонтракту = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьРаботниковПоГигКонтракту), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьРаботниковПоГигКонтракту/ЧислоМесяцев, 5)));
	КонецЕсли;

	
КонецПроцедуры


// Параметры:
//		Организация
//		НачалоПериода
//		КонецПериода
//		ДанныеЧисленности - Структура - с полями ЧисленностьРаботниковЭПЗВнешнихСовместителей, 
//													ЧисленностьРаботниковЭПЗОсновыныхСотрудников, 
//													ЧисленностьРаботниковЭПЗВнутреннихСовместителей
//
Процедура СреднесписочнаяЧисленностьРаботающихЭПЗ(Организация, НачалоПериода, КонецПериода, ДанныеЧисленности, ИсключатьТяжелыеУсловияТруда = Ложь) Экспорт

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация", Организация);
	ПараметрыОтчета.Вставить("ДатаНачалаПериодаОтчета", НачалоПериода);
	ПараметрыОтчета.Вставить("ДатаКонцаПериодаОтчета", КонецПериода);
	ПараметрыОтчета.Вставить("ИсключатьТяжелыеУсловияТруда", ИсключатьТяжелыеУсловияТруда); 
	// Получение данных отчета
	ДанныеОтчета = Новый ДеревоЗначений;
	ДанныеДляЗаполненияРегламентированнойОтчетностиКадрыЭПЗ("СреднесписочнаяЧисленностьЭПЗ",
		ПараметрыОтчета, ДанныеОтчета);
	
	СтрокаОрганизации = ДанныеОтчета.Строки.Найти(Организация, "Организация");
	
	Если СтрокаОрганизации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧислоМесяцев = 12*(Год(НачалоПериода) - Год(КонецПериода)) + Месяц(КонецПериода) - Месяц(НачалоПериода) + 1;
	
	Если ЧислоМесяцев = 0 Тогда
		Возврат;
	КонецЕсли;	         
	ДанныеОтчета = СформироватьДанныеССЧЭПЗ(СтрокаОрганизации, Организация, НачалоПериода, КонецПериода, ИсключатьТяжелыеУсловияТруда);	
	ДанныеЧисленности.ЧисленностьРаботниковЭПЗВнешнихСовместителей = ДанныеОтчета.ЧисленностьРаботниковЭПЗВнешнихСовместителей;
	ДанныеЧисленности.ЧисленностьРаботниковЭПЗОсновыныхСотрудников = ДанныеОтчета.ЧисленностьРаботниковЭПЗОсновыныхСотрудников;	
	ДанныеЧисленности.ЧисленностьРаботниковЭПЗВнутреннихСовместителей = ДанныеОтчета.ЧисленностьРаботниковЭПЗВнутреннихСовместителей;	

КонецПроцедуры

Функция СформироватьДанныеССЧЭПЗ(Данные, Организация, ДатаНачала, ДатаОкончания, ИсключатьТяжелыеУсловияТруда = Ложь) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники")); 
	ТаблицаДанных.Колонки.Добавить("ВидЗанятости", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЗанятости"));
	
	ТаблицаИтоговыхДанных = Новый ТаблицаЗначений;
	ТаблицаИтоговыхДанных.Колонки.Добавить("ВидЗанятости", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЗанятости")); 
	ТаблицаИтоговыхДанных.Колонки.Добавить("Средняя", Новый ОписаниеТипов("Число")); 
	
	ЧисленностьРаботниковЭПЗВнешнихСовместителей = 0;
	ЧисленностьРаботниковЭПЗОсновыныхСотрудников = 0;
	ЧисленностьРаботниковЭПЗВнутреннихСовместителей = 0;
	
	Для Каждого СтрокаМесяца Из Данные.Строки Цикл
		Месяц = СтрокаМесяца.Месяц;    
		Для Каждого СтрокаСотрудника Из СтрокаМесяца.Строки Цикл 
			Если ИсключатьТяжелыеУсловияТруда
			И СтрокаСотрудника.ДолжностьТяжелыеУсловияТруда = ИСТИНА Тогда 
				Продолжить       
			Иначе	
				НоваяСтрока = ТаблицаДанных.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСотрудника);
			КонецЕсли;	
		КонецЦикла;	                                            
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидЗанятости", Перечисления.ВидыЗанятости.Совместительство);
		
		МассивОтбора = ТаблицаДанных.НайтиСтроки(ПараметрыОтбора); 
		ТаблицаОтбора = ПреобразоватьМассивВТаблицу(МассивОтбора);
		ТаблицаДанныхДляВывода = СтатистикаПерсонала.ДанныеВремениДляРасчетаЭПЗ(ТаблицаОтбора, Организация, Месяц); 
		Для Каждого СтрокаДанных Из ТаблицаДанныхДляВывода Цикл
			Если Не СтрокаДанных.Норма = NULL И Не СтрокаДанных.Норма = 0 Тогда 
				НоваяСтрока = ТаблицаИтоговыхДанных.Добавить();
				НоваяСтрока.ВидЗанятости = Перечисления.ВидыЗанятости.Совместительство;
				НоваяСтрока.Средняя = Окр(СтрокаДанных.Работа/СтрокаДанных.Норма, 2)
			КонецЕсли;
		КонецЦикла; 
		ЧисленностьРаботниковЭПЗВнешнихСовместителей = ТаблицаИтоговыхДанных.Итог("Средняя"); 
		ТаблицаИтоговыхДанных.Очистить();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидЗанятости", Перечисления.ВидыЗанятости.ОсновноеМестоРаботы);
		
		МассивОтбора = ТаблицаДанных.НайтиСтроки(ПараметрыОтбора); 
		ТаблицаОтбора = ПреобразоватьМассивВТаблицу(МассивОтбора);
		ТаблицаДанныхДляВывода = СтатистикаПерсонала.ДанныеВремениДляРасчетаЭПЗ(ТаблицаОтбора, Организация, Месяц); 
		Для Каждого СтрокаДанных Из ТаблицаДанныхДляВывода Цикл
			Если Не СтрокаДанных.Норма = NULL И Не СтрокаДанных.Норма = 0 Тогда 
				НоваяСтрока = ТаблицаИтоговыхДанных.Добавить();
				НоваяСтрока.ВидЗанятости = Перечисления.ВидыЗанятости.Совместительство;
				НоваяСтрока.Средняя = Окр(СтрокаДанных.Работа/СтрокаДанных.Норма, 2)
			КонецЕсли;
		КонецЦикла;
		ЧисленностьРаботниковЭПЗОсновыныхСотрудников = ТаблицаИтоговыхДанных.Итог("Средняя"); 
		ТаблицаИтоговыхДанных.Очистить();

		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидЗанятости", Перечисления.ВидыЗанятости.ВнутреннееСовместительство);
		
		МассивОтбора = ТаблицаДанных.НайтиСтроки(ПараметрыОтбора); 
		ТаблицаОтбора = ПреобразоватьМассивВТаблицу(МассивОтбора);
		ТаблицаДанныхДляВывода = СтатистикаПерсонала.ДанныеВремениДляРасчетаЭПЗ(ТаблицаОтбора, Организация, Месяц); 
		Для Каждого СтрокаДанных Из ТаблицаДанныхДляВывода Цикл
			Если Не СтрокаДанных.Норма = NULL И Не СтрокаДанных.Норма = 0 Тогда 
				НоваяСтрока = ТаблицаИтоговыхДанных.Добавить();
				НоваяСтрока.ВидЗанятости = Перечисления.ВидыЗанятости.Совместительство;
				НоваяСтрока.Средняя = Окр(СтрокаДанных.Работа/СтрокаДанных.Норма, 2)
			КонецЕсли;
		КонецЦикла; 
		ЧисленностьРаботниковЭПЗВнутреннихСовместителей = ТаблицаИтоговыхДанных.Итог("Средняя"); 
		ТаблицаИтоговыхДанных.Очистить();
	КонецЦикла;	 
	ДанныеОтчета = Новый Структура("ЧисленностьРаботниковЭПЗВнешнихСовместителей, ЧисленностьРаботниковЭПЗОсновыныхСотрудников, ЧисленностьРаботниковЭПЗВнутреннихСовместителей");
	ДанныеОтчета.ЧисленностьРаботниковЭПЗВнешнихСовместителей = ЧисленностьРаботниковЭПЗВнешнихСовместителей;
	ДанныеОтчета.ЧисленностьРаботниковЭПЗОсновыныхСотрудников = ЧисленностьРаботниковЭПЗОсновыныхСотрудников;  
	ДанныеОтчета.ЧисленностьРаботниковЭПЗВнутреннихСовместителей = ЧисленностьРаботниковЭПЗВнутреннихСовместителей;
	
	Возврат ДанныеОтчета;

КонецФункции   

Функция ПреобразоватьМассивВТаблицу(Массив)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	Для Сч = 0 По Массив.Количество()-1 Цикл
		СтрокаТаблицы = Таблица.Добавить();  
		СтрокаТаблицы.Сотрудник = Массив[Сч].Сотрудник;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура СреднесписочнаяЧисленностьРаботающих10ПИ(Организация, НачалоПериода, КонецПериода, ДанныеЧисленности) Экспорт

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация", Организация);
	ПараметрыОтчета.Вставить("ДатаНачалаПериодаОтчета", НачалоПериода);
	ПараметрыОтчета.Вставить("ДатаКонцаПериодаОтчета", КонецПериода);
	ПараметрыОтчета.Вставить("ДатаНачалаПериодаВыборки", НачалоПериода);
	
	// Получение данных отчета
	ДанныеОтчета = Новый ДеревоЗначений;
	СхемаКомпоновки = Отчеты.СтатистикаПерсонала.ПолучитьМакет("СхемаКомпоновкиДанныхКадры");
	
	ПараметрыОтчета.Вставить("Вариант", "СреднесписочнаяЧисленность");
	
	ЗарплатаКадрыОбщиеНаборыДанных.ЗаполнитьОбщиеИсточникиДанныхОтчета(Новый Структура("СхемаКомпоновкиДанных", СхемаКомпоновки));

	ДанныеДляЗаполненияРегламентированнойОтчетностиКадры10ПИ("СреднесписочнаяЧисленность", СхемаКомпоновки,
		ПараметрыОтчета, ДанныеОтчета);
	
	СтрокаОрганизации = ДанныеОтчета.Строки.Найти(Организация, "Организация");
	
	Если СтрокаОрганизации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧислоМесяцев = 12*(Год(НачалоПериода) - Год(КонецПериода)) + Месяц(КонецПериода) - Месяц(НачалоПериода) + 1;
	
	Если ЧислоМесяцев = 0 Тогда
		Возврат;
	КонецЕсли;	
	

	ДанныеЧисленности.ЧисленностьИнвалидов = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов), 0,Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьИнвалидов/ЧислоМесяцев, 5)));
	ДанныеЧисленности.ЧисленностьРаботников = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленность), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленность/ЧислоМесяцев, 5)));	
	ДанныеЧисленности.ЧисленностьЖенщин = ?(Не ЗначениеЗаполнено(СтрокаОрганизации.СреднесписочнаяЧисленностьЖенщин), 0, Окр(Окр(СтрокаОрганизации.СреднесписочнаяЧисленностьЖенщин/ЧислоМесяцев, 5)));
	ДанныеЧисленности.ЧисленностьМужчин = ДанныеЧисленности.ЧисленностьРаботников - ДанныеЧисленности.ЧисленностьЖенщин;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	КонтактнаяИнформацияФизлица.ЗначенияПолей КАК ЗначенияПолей
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
